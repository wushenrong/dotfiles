{
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/master/doc/json_schema.json",
  "display": {
    // From: https://github.com/fastfetch-cli/fastfetch/discussions/971#discussioncomment-12628729
    "constants": [
      "\u001b[67C",
      "\u001b[67D",
      "\u001b[80C",
      "\u001b[20D",
      "─────────────────────────────────────────────────────────────────────────────"
    ],
    "key": {
      "width": 14
    },
    "separator": ""
  },
  "logo": {
    "padding": {
      "left": 1,
      "right": {{ if (eq .chezmoi.os "windows") -}}2{{- else -}}1{{- end -}},
      "top": 1
    },
    {{- if (eq .chezmoi.os "windows") }}
    "source": "~/Pictures/Terminal/feli.sixel",
    "type": "raw",
    {{- else }}
    "source": "~/Pictures/Terminal/*.png",
    "type": "kitty-direct",
    {{- end }}
    "width": 36
  },
  "modules": [
    {
      "format": "╭─{$5}─╮",
      "outputColor": "38;2;232;47;103",
      "type": "custom"
    },
    {
      "key": "│        OS:{$1} │",
      "keyColor": "38;2;232;47;103",
      "type": "os"
    },
    {
      "key": "│      Host:{$1} │",
      "keyColor": "38;2;232;47;103",
      "type": "host"
    },
    {
      "key": "│    Kernel:{$1} │",
      "keyColor": "38;2;232;47;103",
      "type": "kernel"
    },
    {
      "key": "│    Uptime:{$1} │",
      "keyColor": "38;2;232;47;103",
      "type": "uptime"
    },
    {
      "key": "│  Packages:{$1} │",
      "keyColor": "38;2;232;47;103",
      "type": "packages"
    },
    {
      "key": "│     Shell:{$1} │",
      "keyColor": "38;2;232;47;103",
      "type": "shell"
    },
    {
      "key": "│  Terminal:{$1} │",
      "keyColor": "38;2;232;47;103",
      "type": "terminal"
    },
    {
      "format": "├─{$5}─┤",
      "type": "custom"
    },
    {
      "key": "│       CPU:{$1} │",
      "keyColor": "38;2;170;89;219",
      "type": "cpu"
    },
    {
      "format": "{name}",
      "key": "│       GPU:{$1} │",
      "keyColor": "38;2;170;89;219",
      "type": "gpu"
    },
    {
      "format": "{preferred-width}x{preferred-height} @ {scale-factor}x in {inch}\", {preferred-refresh-rate} Hz",
      "key": "│     Video:{$1} │",
      "keyColor": "38;2;170;89;219",
      "type": "display"
    },
    {
      "key": "│    Memory:{$1} │",
      "keyColor": "38;2;170;89;219",
      "type": "memory"
    },
    {
      "key": "│      Swap:{$1} │",
      "keyColor": "38;2;170;89;219",
      "type": "swap"
    },
    {
      "key": "│      Disk:{$1} │",
      "keyColor": "38;2;170;89;219",
      "type": "disk"
    },
    {
      "key": "│   Battery:{$1} │",
      "keyColor": "38;2;170;89;219",
      "type": "battery"
    },
    {
      "format": "├─{$5}─┤",
      "type": "custom"
    },
    {
      "key": "│        DE:{$1} │",
      "keyColor": "38;2;209;111;179",
      "type": "de"
    },
    {
      "key": "│        WM:{$1} │",
      "keyColor": "38;2;209;111;179",
      "type": "wm"
    },
    {
      "key": "│     Theme:{$1} │",
      "keyColor": "38;2;209;111;179",
      "type": "theme"
    },
    {
      "key": "│  WM Theme:{$1} │",
      "keyColor": "38;2;209;111;179",
      "type": "wmtheme"
    },
    {
      "key": "│      Font:{$1} │",
      "keyColor": "38;2;209;111;179",
      "type": "font"
    },
    {
      "key": "│ Term Font:{$1} │",
      "keyColor": "38;2;209;111;179",
      "type": "terminalfont"
    },
    {
      "key": "│     Icons:{$1} │",
      "keyColor": "38;2;209;111;179",
      "type": "icons"
    },
    {
      "key": "│    Cursor:{$1} │",
      "keyColor": "38;2;209;111;179",
      "type": "cursor"
    },
    {
      "condition": {
        "succeeded": true
      },
      "format": "├─{$5}─┤",
      "type": "custom"
    },
    {
      "key": "│      User:{$1} │",
      "keyColor": "38;2;237;145;171",
      "type": "title"
    },
    {
      "key": "│  Local IP:{$1} │",
      "keyColor": "38;2;237;145;171",
      "type": "localip"
    },
    {
      "key": "│    Locale:{$1} │",
      "keyColor": "38;2;237;145;171",
      "type": "locale"
    },
    {
      "format": "╰──{$5}{$4}┬─ {#black} {#red} {#green} {#yellow} {#blue} {#magenta} {#cyan} {#white}{#38;2;237;145;171} ─┤",
      "outputColor": "38;2;237;145;171",
      "type": "custom"
    },
    {
      "format": "{$3}{$4}╰─ {#bright_black} {#bright_red} {#bright_green} {#bright_yellow} {#bright_blue} {#bright_magenta} {#bright_cyan} {#bright_white}{#reset_default}{#38;2;237;145;171} ─╯",
      "outputColor": "38;2;237;145;171",
      "type": "custom"
    },
    "break"
  ]
}
