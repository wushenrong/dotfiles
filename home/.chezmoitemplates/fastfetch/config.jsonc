{
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/master/doc/json_schema.json",
  "display": {
    "color": {
      "separator": "#FDEC52"
    },
    "key": {
      "width": 15
    },
    "separator": " │ "
  },
  "logo": {
    "height": 18,
    "padding": {
      "left": 1,
      "right": 1,
      "top": 1
    },
    // {{- if (eq .chezmoi.os "windows") }}
    "source": "~/Pictures/Terminal/Cards/feli_7.png",
    "type": "sixel",
    // {{- else }}
    // "source": "~/Pictures/Terminal/Cards/*.png",
    // "type": "kitty-direct",
    // {{- end }}
    "width": 36
  },
  "modules": [
    {
      "format": "╭───────────┬─────────── {#black}★ {#red}★ {#green}★ {#yellow}★ {#blue}★ {#magenta}★ {#cyan}★ {#white}★{#reset_default}",
      "outputColor": "#FFFFFF",
      "type": "custom"
    },
    {
      "key": "│        OS",
      "keyColor": "#E82F67",
      "type": "os"
    },
    {
      "key": "│      Host",
      "keyColor": "#E82F67",
      "type": "host"
    },
    {
      "key": "│    Kernel",
      "keyColor": "#E82F67",
      "type": "kernel"
    },
    {
      "key": "│    Uptime",
      "keyColor": "#E82F67",
      "type": "uptime"
    },
    {
      "key": "│  Packages",
      "keyColor": "#E82F67",
      "type": "packages"
    },
    {
      "key": "│     Shell",
      "keyColor": "#E82F67",
      "type": "shell"
    },
    {
      "key": "│  Terminal",
      "keyColor": "#E82F67",
      "type": "terminal"
    },
    {
      "format": "├───────────┼───┤",
      "outputColor": "#FFFFFF",
      "type": "custom"
    },
    {
      "key": "│       CPU",
      "keyColor": "#AA59DB",
      "type": "cpu"
    },
    {
      "format": "{name}",
      "key": "│       GPU",
      "keyColor": "#AA59DB",
      "type": "gpu"
    },
    {
      "key": "│     Video",
      "keyColor": "#AA59DB",
      "type": "display"
    },
    {
      "key": "│    Memory",
      "keyColor": "#AA59DB",
      "type": "memory"
    },
    {
      "key": "│      Swap",
      "keyColor": "#AA59DB",
      "type": "swap"
    },
    {
      "key": "│      Disk",
      "keyColor": "#AA59DB",
      "type": "disk"
    },
    {
      "key": "│   Battery",
      "keyColor": "#AA59DB",
      "type": "battery"
    },
    {
      "format": "├───────────┼───┤",
      "outputColor": "#FFFFFF",
      "type": "custom"
    },
    {
      "key": "│        DE",
      "keyColor": "#D16FB3",
      "type": "de"
    },
    {
      "key": "│        WM",
      "keyColor": "#D16FB3",
      "type": "wm"
    },
    {
      "key": "│     Theme",
      "keyColor": "#D16FB3",
      "type": "theme"
    },
    {
      "key": "│  WM Theme",
      "keyColor": "#D16FB3",
      "type": "wmtheme"
    },
    {
      "key": "│      Font",
      "keyColor": "#D16FB3",
      "type": "font"
    },
    {
      "key": "│ Term Font",
      "keyColor": "#D16FB3",
      "type": "terminalfont"
    },
    {
      "key": "│     Icons",
      "keyColor": "#D16FB3",
      "type": "icons"
    },
    {
      "condition": {
        "succeeded": true
      },
      "format": "├───────────┼───┤",
      "outputColor": "#FFFFFF",
      "type": "custom"
    },
    {
      "key": "│      User",
      "keyColor": "#FAA8C1",
      "type": "title"
    },
    {
      "key": "│  Local IP",
      "keyColor": "#FAA8C1",
      "type": "localip"
    },
    {
      "key": "│    Locale",
      "keyColor": "#FAA8C1",
      "type": "locale"
    },
    {
      "format": "╰───────────┴─────────── {#bright_black}★ {#bright_red}★ {#bright_green}★ {#bright_yellow}★ {#bright_blue}★ {#bright_magenta}★ {#bright_cyan}★ {#bright_white}★{#reset_default}",
      "outputColor": "#FFFFFF",
      "type": "custom"
    },
    "break"
  ]
}
