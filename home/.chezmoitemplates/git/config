# Git Setup
[user]
  name = {{ .name }}
  email = {{ .email }}
  signingKey = {{ .chezmoi.homeDir }}/.ssh/id_yubikey_main

[core]
  compression = 9
  editor = code -w
  whitespace = error
  pager = delta
  preloadindex = true

[advice]
  addEmptyPathspec = false
  commitBeforeMerge = false
  detachedHead = false
  implicitIdentity = false
  pushNonFFCurrent = false
  resolveConflict = false
  statusHints = false

[init]
  defaultBranch = main

[column]
  ui = auto

# Git Status
[status]
  branch = true
  showStash = true
  showUntrackedFiles = all
  submoduleSummary = true

# Git Diff
[merge]
  autoStash = true
  conflictStyle = zdiff3

[interactive]
  diffFilter = delta --color-only

[diff]
  algorithm = histogram
  colorMoved = dimmed-zebra
  interHunkContext = 10
  mnemonicPrefix = true
  renames = copies

[delta]
  features = mantis-shrimp zebra-dark
  line-numbers = true
  hyperlinks = true
  hyperlinks-file-link-format = "vscode://file/{path}:{line}"
  navigate = true
  side-by-side = hunk,120
  tabs = 4

# Themes from https://github.com/dandavison/delta/blob/main/themes.gitconfig
[delta "mantis-shrimp"]
  keep-plus-minus-markers = true
  file-added-label = [+]
  file-copied-label = [==]
  file-modified-label = [*]
  file-removed-label = [-]
  file-renamed-label = [->]
  file-style = omit
  zero-style = syntax
  commit-decoration-style ="#11ce16" box
  commit-style = "#ffd21a" bold italic
  hunk-header-decoration-style = "#1688f0" box ul
  hunk-header-file-style = "#c63bee" ul bold
  hunk-header-line-number-style = "#ffd21a" box bold
  hunk-header-style = file line-number syntax bold italic
  line-numbers = true
  line-numbers-left-format = "{nm:>1}|"
  line-numbers-left-style = "#1688f0"
  line-numbers-minus-style = "#ff0051" bold
  line-numbers-plus-style = "#03e57f" bold
  line-numbers-right-format = "{np:>1}|"
  line-numbers-right-style = "#1688f0"
  line-numbers-zero-style = "#aaaaaa" italic
  minus-emph-style = syntax bold "#b80000"
  minus-style = syntax "#5d001e"
  plus-emph-style = syntax bold "#007800"
  plus-style = syntax "#004433"
  whitespace-error-style = "#280050"

[delta "zebra-dark"]
  map-styles = \
    bold purple => syntax "#330f29", \
    bold blue => syntax "#271344", \
    bold cyan => syntax "#0d3531", \
    bold yellow => syntax "#222f14"

# Git Commit
[commit]
  gpgSign = true
{{- if (eq .chezmoi.os "linux")  }}
  template = {{ .chezmoi.homeDir }}/.config/git/template
{{- else }}
  template = {{ .chezmoi.homeDir }}/AppData/Roaming/git/template
{{- end }}
  verbose = true

# Git Pull, Push, and Rebase
[fetch]
  all = true
  prune = true
  pruneTags = true
  recurseSubmodules = on-demand

[pull]
  rebase = true

[push]
  autoSetupRemote = true
  autoSquash = true
  followTags = true
  recurseSubmodules = on-demand

[submodule]
  fetchJobs = 16
  recurse = true

[rebase]
  abbreviateCommands = true
  autoStash = true
  autoSquash = true
  missingCommitsCheck = error
  updateRefs = true

[rerere]
  autoUpdate = true
  enabled = true

# Git Branch, Tag, and Log
[branch]
  sort = -committerdate

[tag]
  gpgSign = true
  sort = version:refname

[log]
  abbrevCommit = true

# Git Alias
[alias]
  amend = cam
  renormalize = add -A --renormalize
  unstage = rs

  a = add
  aa = a -A
  ai = a -i
  ap = a -p
  au = a -u

  b = branch
  ba = b -a
  bd = b -d
  bdd = b -D
  bm = b -m
  bmm = b -m

  c = commit
  cs = c -s

  ca = c -a
  cas = ca -s

  ci = c -i
  cis = ci -s

  cam = c --amend
  caa = cam -a

  cl = clone --recurse-submodules

  cp = cherry-pick

  cpa = cp --abort
  cpas = cpa -s

  cpc = cp --continue
  cpcs = cpc -s

  cps = cp --skip
  cpss = cps -s

  d = diff
  ds = d --staged

  dt = -c diff.external=difft d
  dts = dt --staged

  dtl = -c diff.external=difft lp --ext-diff
  dts = -c diff.external=difft sh --ext-diff

  h = history
  hd = h drop
  hf = h fixup
  hr = h reword
  hs = h split

  i = init

  l = log --graph
  lp = l -p

  m = merge
  ma = m --abort
  mc = m --continue

  p = push
  pf = p --force-with-lease --force-if-includes

  pl = pull
  plr = pl --recurse-submodules

  r = restore
  rp = r -p

  rs = r -S
  rsp = rs -p
  rsw = rs -W

  rb = rebase
  rbm = rb main

  rba = rb --abort
  rbc = rb --continue
  rbs = rb --skip

  rbi = rb -i
  rbir = rbi --root

  s = status
  sh = show

  sm = submodule
  sma = sm add
  sms = sm status
  smi = sm update --init --recursive
  smu = sm update --remote --recursive

  st = stash
  stb = st branch
  std = st drop
  stl = st list
  stp = st pop

  sta = st -a
  stp = st -p
  sts = st -S
  stu = st -u

  sw = switch
  swm = sw main

  swc = sw -c
  swp = sw -

  wt = worktree
  wta = wt add
  wtl = wt list
  wtr = wt remove

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[gpg]
  format = ssh

[gpg "ssh"]
{{- if (eq .chezmoi.os "linux")  }}
  allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers
{{- else }}
  allowedSignersFile = {{ .chezmoi.homeDir }}/AppData/Roaming/git/allowed_signers
{{- end }}

[url "https://github.com/"]
  insteadOf = "gh:"

[url "https://github.com/wushenrong/"]
  insteadOf = "wsr:"

{{- if (and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft")) }}
[credential]
  helper = /mnt/c/Program\\ Files/Git/mingw64/bin/git-credential-manager.exe
{{- end }}
