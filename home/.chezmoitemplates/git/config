# Git Setup
[user]
  name = {{ .name }}
  email = {{ .email }}
  signingKey = {{ .chezmoi.homeDir }}/.ssh/id_yubikey_main

[core]
  compression = 9
  editor = code --wait
  whitespace = error
  pager = delta
  preloadindex = true

[advice]
  addEmptyPathspec = false
  commitBeforeMerge = false
  detachedHead = false
  implicitIdentity = false
  pushNonFFCurrent = false
  resolveConflict = false
  statusHints = false

[init]
  defaultBranch = main

[column]
  ui = auto

# Git Status
[status]
  branch = true
  showStash = true
  showUntrackedFiles = all
  submoduleSummary = true

# Git Diff
[merge]
  autoStash = true
  conflictStyle = zdiff3

[interactive]
  diffFilter = delta --color-only

[diff]
  algorithm = histogram
  colorMoved = default
  interHunkContext = 10
  mnemonicPrefix = true
  renames = copies

[delta]
  line-numbers = true
  hyperlinks = true
  hyperlinks-file-link-format = "vscode://file/{path}:{line}"
  navigate = true
  side-by-side = true
  tabs = 4

# Git Commit
[commit]
  gpgSign = true
{{- if (eq .chezmoi.os "linux")  }}
  template = {{ .chezmoi.homeDir }}/.config/git/template
{{- else }}
  template = {{ .chezmoi.homeDir }}/AppData/Roaming/git/template
{{- end }}
  verbose = true

# Git Pull, Push, and Rebase
[fetch]
  all = true
  prune = true
  pruneTags = true
  recurseSubmodules = on-demand

[pull]
  rebase = true

[push]
  autoSetupRemote = true
  autoSquash = true
  followTags = true
  recurseSubmodules = on-demand

[submodule]
  fetchJobs = 16
  recurse = true

[rebase]
  abbreviateCommands = true
  autoStash = true
  autoSquash = true
  missingCommitsCheck = error
  updateRefs = true

[rerere]
  autoUpdate = true
  enabled = true

# Git Branch, Tag, and Log
[branch]
  sort = -committerdate

[tag]
  gpgSign = true
  sort = version:refname

[log]
  abbrevCommit = true

# Git Alias
[alias]
  amend = cam
  renormalize = add --all --renormalize
  unstage = rs

  a = add
  aa = a --all
  ai = a --interactive
  ap = a --patch
  au = a --update

  b = branch
  ba = b --all
  bd = b --delete
  bm = b --move

  c = commit
  cs = c --signoff

  ca = c --all
  cas = ca --signoff

  ci = c --interactive
  cis = ci --signoff

  cam = c --amend
  caa = cam --all

  cl = clone --recurse-submodules

  cp = cherry-pick
  cpa = cp --abort
  cpc = cp --continue
  cps = cp --skip

  d = diff
  dc = d --cached
  ds = d --staged

  dt = -c diff.external=difft d
  dtc = dt --cached
  dts = dt --staged

  dtl = -c diff.external=difft lp --ext-diff
  dts = -c diff.external=difft sh --ext-diff

  i = init

  l = log --graph
  lp = l --patch

  m = merge
  ma = m --abort
  mc = m --continue

  p = push
  pf = p --force-with-lease --force-if-includes

  pl = pull
  plr = pl --recurse-submodules

  r = restore
  rp = r --patch

  rs = r --staged
  rsp = rs --patch
  rsw = rs --worktree

  rb = rebase
  rbm = rb main

  rba = rb --abort
  rbc = rb --continue
  rbs = rb --skip

  rbi = rb --interactive
  rbir = rbi --root

  s = status
  sh = show

  sm = submodule
  sma = sm add
  sms = sm status
  smi = sm update --init --recursive
  smu = sm update --remote --recursive

  st = stash
  stb = st branch
  std = st drop
  stl = st list
  stp = st pop

  sta = st --all
  sts = st --staged
  stu = st --include-untracked

  sw = switch
  swm = sw main

  swc = sw --create
  swp = sw -

  wt = worktree
  wta = wt add
  wtl = wt list
  wtr = wt remove

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[gpg]
  format = ssh

[gpg "ssh"]
{{- if (eq .chezmoi.os "linux")  }}
  allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers
{{- else }}
  allowedSignersFile = {{ .chezmoi.homeDir }}/AppData/Roaming/git/allowed_signers
{{- end }}

[url "https://github.com/"]
  insteadOf = "gh:"

[url "https://github.com/wushenrong/"]
  insteadOf = "wsr:"

{{- if (and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft")) }}
[credential]
  helper = /mnt/c/Program\\ Files/Git/mingw64/bin/git-credential-manager.exe
{{- end }}
