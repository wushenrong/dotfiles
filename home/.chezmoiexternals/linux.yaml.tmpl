{{ if (eq .chezmoi.os "linux") -}}
nano_extras:
  exact: true
  refreshPeriod: 672h
  stripComponents: 1
  targetPath: .local/share/nano/extras
  type: archive
  url: https://github.com/galenguyer/nano-syntax-highlighting/archive/master.tar.gz

{{ if (not (.chezmoi.kernel.osrelease | lower | contains "microsoft")) -}}
mpv_config:
  exact: true
  private: true
  stripComponents: 1
  targetPath: .config/mpv
  type: archive
  url: https://github.com/wushenrong/mpv-config/archive/master.tar.gz
{{ end -}}

tpm:
  refreshPeriod: 672h
  stripComponents: 1
  targetPath: .local/share/tmux/plugins/tpm
  type: archive
  url: https://github.com/tmuxpack/tpack/archive/master.tar.gz

vcpkg:
  refreshPeriod: 168h
  targetPath: .local/share/vcpkg
  type: git-repo
  url: https://github.com/microsoft/vcpkg.git

zdotdir:
  exact: true
  private: true
  stripComponents: 1
  targetPath: .config/zsh
  type: archive
  url: https://github.com/wushenrong/zdotdir/archive/main.tar.gz
{{ end -}}
