stripComponents = 1
type = "archive"
url = "https://github.com/romkatv/zsh-bench/archive/master.tar.gz"

[".local/share/zsh/powerlevel10k"]
refreshPeriod = "672h"
stripComponents = 1
type = "archive"
url = "https://github.com/romkatv/powerlevel10k/archive/master.tar.gz"
