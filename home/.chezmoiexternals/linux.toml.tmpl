{{ if (eq .chezmoi.os "linux") -}}
[".config/mpv"]
exact = true
private = true
stripComponents = 1
type = "archive"
url = "https://github.com/wushenrong/mpv-config/archive/master.tar.gz"

[".config/zsh"]
exact = true
private = true
stripComponents = 1
type = "archive"
url = "https://github.com/wushenrong/zdotdir/archive/main.tar.gz"

[".local/share/nano/extras"]
exact = true
refreshPeriod = "672h"
stripComponents = 1
type = "archive"
url = "https://github.com/galenguyer/nano-syntax-highlighting/archive/master.tar.gz"

[".local/share/tmux/plugins/tpm"]
exact = true
refreshPeriod = "672h"
stripComponents = 1
type = "archive"
url = "https://github.com/tmuxpack/tpack/archive/master.tar.gz"

[".local/share/vcpkg"]
refreshPeriod = "168h"
type = "git-repo"
url = "https://github.com/microsoft/vcpkg.git"
{{ end -}}
