configuration {
  modes: "drun,run,combi";
  font: "Mono 14";
  show-icons: true;
  terminal: "kitty";
  icon-theme: "Papirus";
  combi-modes: "drun,run";
}

@theme "Arc-Dark"

element-icon {
  size: 2.2ch;
}

element-text {
  vertical-align: 0.5;
}
