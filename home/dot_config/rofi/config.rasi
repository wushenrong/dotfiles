configuration {
  modes: "combi";
  font: "Noto Sans Mono 14";
  show-icons: true;
  terminal: "kitty";
  ssh-client: "kitty +kitten ssh";
  icon-theme: "Papirus";
  combi-modes: "drun,run,window";
}

@theme "Arc-Dark"

element-icon {
  size: 2.2ch;
}

element-text {
  vertical-align: 0.5;
}
