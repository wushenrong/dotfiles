* {
  background-color: transparent;
  text-color: #fff;
  spacing: 2;
  separator-color: rgba(102, 102, 102, 0.2);
  selected-color: rgba(255, 255, 255, 0.1);
  special-background-color: rgba(255, 255, 255, 0.45);
  special-selected-color: #000;
  urgent-text-color: #cd3131;
  active-text-color: #2472c8;
}

window {
  padding: 5;
  width: 1024;
  height: 630;
  background-color: #fff;
  background-image: url("~/Pictures/interlude_46.png", both);
  border: 1;
}

mainbox {
  background-color: rgba(227, 0, 140, 0.5);
  padding: 0;
  border: 0;
}

message {
  padding: 1px;
  border-color: var(separator-color);
  border: 4px 0px 0px;
}

textbox {
  background-color: rgba(0, 0, 0, 0.8);
  text-color: #cd3131;
}

listview {
  padding: 2px 0px 0px;
  scrollbar: true;
  border-color: var(separator-color);
  spacing: 2px;
  fixed-height: 0;
  border: 4px 0px 0px;
}

element {
  padding: 1px;
  border: 0;
}

element-icon {
  size: 1.0em;
}

element-text {
  text-color: inherit;
}

element normal.urgent {
  background-color: var(special-background-color);
  text-color: var(urgent-text-color);
}

element normal.active {
  background-color: var(special-background-color);
  text-color: var(active-text-color);
}

element selected.normal {
  background-color: var(selected-color);
}

element selected.urgent {
  background-color: rgba(205, 49, 49, 0.5);
  text-color: var(special-selected-color);
}

element selected.active {
  background-color: rgba(36, 114, 200, 0.5);
  text-color: var(special-selected-color);
}

element alternate.urgent {
  background-color: var(special-background-color);
  text-color: var(urgent-text-color);
}

element alternate.active {
  background-color: var(special-background-color);
  text-color: var(active-text-color);
}

scrollbar {
  width: 2px;
  padding: 0;
  handle-width: 4px;
  border: 0;
  handle-color: rgba(255, 255, 255, 0.5);
}

button {
  spacing: 0;
}

button selected {
  background-color: var(selected-color);
}

inputbar {
  padding: 1px;
  spacing: 0px;
  children: [
    prompt,
    textbox-prompt-colon,
    entry,
    case-indicator
  ];
}

case-indicator {
  spacing: 0;
}

entry {
  spacing: 0;
}

prompt {
  spacing: 0;
}

textbox-prompt-colon {
  margin: 0px 0.3em 0em 0em;
  expand: false;
  str: ":";
}
