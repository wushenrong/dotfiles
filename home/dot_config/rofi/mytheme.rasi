/**
 * rofi -dump-theme output.
 * Rofi version: 2.1.0
 **/
* {
  background-color: transparent;
  text-color: white;
  spacing: 2;
  separator-color: rgba(102, 102, 102, 20%);
  selected-color: rgba(255, 255, 255, 10%);
  special-background-color: rgba(255, 255, 255, 35%);
  special-selected-color: black;
  urgent-text-color: #cd3131;
  active-text-color: #268bd2;
}

window {
  padding: 5;
  width: 1024;
  height: 630;
  background-color: white;
  background-image: url("~/Pictures/interlude_46.png", both);
  border: 1;
}

mainbox {
  background-color: rgba(227, 0, 140, 40%);
  padding: 0;
  border: 0;
}

message {
  padding: 1px;
  border-color: var(separator-color);
  border: 4px 0px 0px;
}

textbox {
  background-color: rgba(0, 0, 0, 80%);
  text-color: #f14c4c;
}

listview {
  padding: 2px 0px 0px;
  scrollbar: true;
  border-color: var(separator-color);
  spacing: 2px;
  fixed-height: 0;
  border: 4px 0px 0px;
}

element {
  padding: 1px;
  border: 0;
}

element-icon {
  size: 1.0em;
}

element-text {
  background-color: inherit;
  text-color: inherit;
}

element normal.urgent {
  background-color: var(special-background-color);
  text-color: var(urgent-text-color);
}

element normal.active {
  background-color: var(special-background-color);
  text-color: var(active-text-color);
}

element selected.normal {
  background-color: var(selected-color);
}

element selected.urgent {
  background-color: rgba(205, 49, 49, 50%);
  text-color: var(special-selected-color);
}

element selected.active {
  background-color: rgba(38, 139, 210, 50%);
  text-color: var(special-selected-color);
}

element alternate.urgent {
  background-color: var(special-background-color);
  text-color: var(urgent-text-color);
}

element alternate.active {
  background-color: var(special-background-color);
  text-color: var(active-text-color);
}

scrollbar {
  width: 2px;
  padding: 0;
  handle-width: 4px;
  border: 0;
  handle-color: rgba(255, 255, 255, 50%);
}

button {
  spacing: 0;
}

button selected {
  background-color: var(selected-color);
}

inputbar {
  padding: 1px;
  spacing: 0px;
  children: [
    prompt,
    textbox-prompt-colon,
    entry,
    case-indicator
  ];
}

case-indicator {
  spacing: 0;
}

entry {
  spacing: 0;
}

prompt {
  spacing: 0;
}

textbox-prompt-colon {
  margin: 0px 0.3em 0em 0em;
  expand: false;
  str: ":";
}
