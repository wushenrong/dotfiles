// -*- mode: jsonc -*-
{
  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": [
      "🌑",
      "🌘",
      "🌗",
      "🌖",
      "🌕"
    ],
    "tooltip": false
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-alt": "{time} {icon}",
    "format-charging": "{capacity}% 󰃨",
    "format-full": "{capacity}% {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "format-plugged": "{capacity}% ",
    "states": {
      "critical": 15,
      "good": 80,
      "warning": 30
    }
  },
  "clock": {
    "calendar": {
      "format": {
        "months": "<span color='#23d18b'>{}</span>",
        "today": "<span color='#f14c4c'><b><u>{}</u></b></span>",
        "weekdays": "<span color='#e5e510'>{}</span>"
      }
    },
    "format": "{:%A, %B %d - %H:%M}",
    "format-alt": "{:%Y-%m-%d - %H:%M}",
    "tooltip-format": "{calendar}"
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip": false
  },
  "disk": {
    "format": "{percentage_used}% ",
    "tooltip-format": "{specific_used:0.1f}GiB / {specific_total:0.1f}GiB used on {path}",
    "unit": "GiB"
  },
  "height": 32,
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "memory": {
    "format": "{percentage}% ",
    "tooltip-format": "{used:0.1f}GiB / {total:0.1f}GiB used"
  },
  "modules-center": [
    "clock"
  ],
  "modules-left": [
    "sway/workspaces",
    "sway/mode",
    "sway/scratchpad"
  ],
  "modules-right": [
    "idle_inhibitor",
    "power-profiles-daemon",
    "pulseaudio",
    "cpu",
    "memory",
    "disk",
    "temperature",
    "backlight",
    "battery",
    "tray"
  ],
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "balanced": "",
      "default": "",
      "performance": "",
      "power-saver": ""
    },
    "tooltip": true,
    "tooltip-format": "Power profile: {profile}\nCPU driver: {cpu_driver}\nPlatform driver: {platform_driver}"
  },
  "pulseaudio": {
    "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-icons": {
      "car": "",
      "default": [
        "",
        "",
        ""
      ],
      "hands-free": "󰂑",
      "headphone": "",
      "headset": "󰂑",
      "phone": "",
      "portable": ""
    },
    "format-muted": " {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "on-click": "pavucontrol"
  },
  "spacing": 4,
  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>"
  },
  "sway/scratchpad": {
    "format": "{icon} {count}",
    "format-icons": [
      "",
      ""
    ],
    "show-empty": false,
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },
  "sway/workspaces": {
    "all-outputs": true,
    "disable-scroll": true,
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "default": "",
      "high-priority-named": [
        "1",
        "2",
        "3"
      ],
      "urgent": ""
    },
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": []
    },
    "warp-on-scroll": false
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C {icon}",
    "format-icons": [
      "󰉬",
      "",
      "󰉪"
    ],
    "tooltip-format": "{temperatureF}°F"
  },
  "tray": {
    "spacing": 10
  }
}
