// -*- mode: jsonc -*-
{
  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": [
      "🌑",
      "🌘",
      "🌗",
      "🌖",
      "🌕"
    ],
    "min-brightness": 1
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-alt": "{time} {icon}",
    "format-charging": "{capacity}% 󰃨",
    "format-full": "{capacity}% {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "format-plugged": "{capacity}% ",
    "states": {
      "critical": 15,
      // "good": 95,
      "warning": 30
    }
  },
  "clock": {
    "format": "{:%H:%M:%S}",
    "format-alt": "{:%Y-%m-%d}",
    "interval": 1,
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip": false
  },
  "disk": {
    "format": "{percentage_free}% "
  },
  // "height": 30, // Waybar height (to be removed for auto height)
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "memory": {
    "format": "{}% "
  },
  "modules-center": [
    "clock"
  ],
  "modules-left": [
    "sway/workspaces",
    "sway/mode",
    "sway/scratchpad"
  ],
  "modules-right": [
    "privacy",
    "idle_inhibitor",
    "backlight",
    "pulseaudio",
    "cpu",
    "memory",
    "disk",
    "temperature",
    "battery",
    "power-profiles-daemon",
    "tray"
  ],
  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "balanced": "",
      "default": "",
      "performance": "",
      "power-saver": ""
    },
    "tooltip": true,
    "tooltip-format": "Power profile: {profile}\nCPU driver: {cpu_driver}\nPlatform driver: {platform_driver}"
  },
  "pulseaudio": {
    "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "format-muted": " {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "on-click": "pavucontrol"
  },
  "spacing": 4,
  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>"
  },
  "sway/scratchpad": {
    "format": "{icon} {count}",
    "format-icons": [
      "",
      ""
    ],
    "show-empty": false,
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },
  "sway/workspaces": {
    "all-outputs": true,
    "disable-scroll": true,
    "format": "{index} {icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "default": "",
      "focused": "",
      "high-priority-named": [
        "1",
        "2",
        "3"
      ],
      "urgent": ""
    },
    "warp-on-scroll": false
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C {icon}",
    "format-icons": [
      "󰉬",
      "",
      "󰉪"
    ]
  },
  "tray": {
    "spacing": 10
  }
}
