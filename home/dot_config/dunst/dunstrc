# From https://github.com/Hugh-ONeill/dotfiles/blob/main/.config/dunst/dunstrc

[global]
### Display ###
follow = mouse

### Geometry ###
notification_limit = 5

### Progress bar ###
progress_bar_corner_radius = 4
frame_width = 2
gap_size = 4

### Text ###
font = Noto Sans Mono 12

format = "<b>󰁕 %a</b>\n%s\n<i>%b</i>"

### Icons ###
icon_theme = Papirus
max_icon_size = 64
icon_path = /usr/share/icons/Papirus-Dark/48x48/apps:/usr/share/icons/Papirus-Dark/48x48/status:/usr/share/icons/hicolor/48x48/apps

### Misc/Advanced ###
dmenu = /usr/bin/rofi -dmenu -p "dunst:"

corner_radius = 4

### Wayland ###

### mouse
mouse_left_click = do_action, close_current
mouse_right_click = close_all
mouse_middle_click = context_all

[urgency_low]
timeout = 10
default_icon = preferences-desktop-notification-bell

[urgency_normal]
timeout = 20
default_icon = preferences-desktop-notification-bell

[urgency_critical]
timeout = 0
default_icon = dialog-warning
